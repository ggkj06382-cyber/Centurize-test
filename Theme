function ThemeManager:SetLibrary(lib)
    self.Library = lib
end

function ThemeManager:BuildFolderTree()
    for _, path in ipairs({
        self.Folder,
        self.Folder .. "/themes",
        self.Folder .. "/settings",
    }) do
        if not isfolder(path) then
            makefolder(path)
        end
    end
end

function ThemeManager:SetFolder(folder)
    self.Folder = folder
    self:BuildFolderTree()
end

function ThemeManager:GetCustomTheme(name)
    if not name or name == "" then
        return nil
    end

    local path = self.Folder .. "/themes/" .. name .. ".json"

    if not isfile(path) then
        return nil
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if success and type(data) == "table" then
        return data
    end

    return nil
end

function ThemeManager:ApplyTheme(name)
    if not self.Library then
        return
    end

    local builtIn = self.BuiltInThemes[name]
    local colors = builtIn and builtIn[2] or self:GetCustomTheme(name)

    if not colors then
        return
    end

    for field, hex in pairs(colors) do
        local success, color = pcall(function()
            return Color3.fromHex(hex)
        end)

        if success then
            self.Library[field] = color

            if Options and Options[field] then
                Options[field]:SetValueRGB(color)
            end
        end
    end

    self:ThemeUpdate()
end

function ThemeManager:ThemeUpdate()
    if not self.Library then
        return
    end

    local fields = {
        "FontColor",
        "MainColor",
        "AccentColor",
        "BackgroundColor",
        "OutlineColor",
    }

    for _, field in ipairs(fields) do
        if Options and Options[field] then
            self.Library[field] = Options[field].Value
        end
    end

    self.Library.AccentColorDark =
        self.Library:GetDarkerColor(self.Library.AccentColor)

    self.Library:UpdateColorsUsingRegistry()
end

function ThemeManager:LoadDefault()
    -- Always start with Obsidian, ignoring the saved default.
    self:ApplyTheme("Obsidian")

    if Options and Options.ThemeManager_ThemeList then
        Options.ThemeManager_ThemeList:SetValue("Obsidian")
    end
end

function ThemeManager:SaveDefault(name)
    -- Obsidian remains the startup theme regardless of this setting.
    -- This function is retained for compatibility with the UI.
    self.Library:Notify(
        "Obsidian will always load at startup."
    )
end

function ThemeManager:ReloadCustomThemes()
    local result = {}

    for _, path in ipairs(listfiles(self.Folder .. "/themes")) do
        local filename = path:match("([^/\\]+)$")

        if filename and filename:sub(-5) == ".json" then
            table.insert(result, filename:sub(1, -6))
        end
    end

    table.sort(result)
    return result
end

function ThemeManager:SaveCustomTheme(name)
    if not name or name:gsub("%s", "") == "" then
        self.Library:Notify("Enter a valid theme name.", 3)
        return
    end

    local colors = {}

    for _, field in ipairs({
        "FontColor",
        "MainColor",
        "AccentColor",
        "BackgroundColor",
        "OutlineColor",
    }) do
        colors[field] = Options[field].Value:ToHex()
    end

    writefile(
        self.Folder .. "/themes/" .. name .. ".json",
        HttpService:JSONEncode(colors)
    )

    self.Library:Notify("Theme saved: " .. name)
end

function ThemeManager:CreateThemeManager(groupbox)
    local defaults = {
        BackgroundColor = self.Library.BackgroundColor,
        MainColor = self.Library.MainColor,
        AccentColor = self.Library.AccentColor,
        OutlineColor = self.Library.OutlineColor,
        FontColor = self.Library.FontColor,
    }

    for _, field in ipairs({
        "BackgroundColor",
        "MainColor",
        "AccentColor",
        "OutlineColor",
        "FontColor",
    }) do
        groupbox:AddLabel(field:gsub("(%u)", " %1"):gsub("^ ", ""))
            :AddColorPicker(field, {Default = defaults[field]})
    end

    local names = {}

    for name in pairs(self.BuiltInThemes) do
        table.insert(names, name)
    end

    table.sort(names, function(a, b)
        return self.BuiltInThemes[a][1] < self.BuiltInThemes[b][1]
    end)

    groupbox:AddDivider()

    groupbox:AddDropdown("ThemeManager_ThemeList", {
        Text = "Built-in themes",
        Values = names,
        Default = 1,
    })

    Options.ThemeManager_ThemeList:OnChanged(function()
        local selected = Options.ThemeManager_ThemeList.Value

        if selected then
            self:ApplyTheme(selected)
        end
    end)

    groupbox:AddButton("Set as default", function()
        self:SaveDefault(Options.ThemeManager_ThemeList.Value)
    end)

    groupbox:AddDivider()

    groupbox:AddInput("ThemeManager_CustomThemeName", {
        Text = "Custom theme name",
    })

    groupbox:AddDropdown("ThemeManager_CustomThemeList", {
        Text = "Saved themes",
        Values = self:ReloadCustomThemes(),
        AllowNull = true,
    })

    groupbox:AddButton("Save theme", function()
        self:SaveCustomTheme(
            Options.ThemeManager_CustomThemeName.Value
        )

        Options.ThemeManager_CustomThemeList:SetValues(
            self:ReloadCustomThemes()
        )
    }):AddButton("Load theme", function()
        local selected = Options.ThemeManager_CustomThemeList.Value

        if selected then
            self:ApplyTheme(selected)
        end
    end)

    groupbox:AddButton("Refresh list", function()
        Options.ThemeManager_CustomThemeList:SetValues(
            self:ReloadCustomThemes()
        )
    end)

    groupbox:AddButton("Set saved theme as default", function()
        self.Library:Notify(
            "Obsidian will always load at startup."
        )
    end)

    local function update()
        self:ThemeUpdate()
    end

    for _, field in ipairs({
        "BackgroundColor",
        "MainColor",
        "AccentColor",
        "OutlineColor",
        "FontColor",
    }) do
        Options[field]:OnChanged(update)
    end

    self:LoadDefault()
end

function ThemeManager:CreateGroupBox(tab)
    assert(self.Library, "Call ThemeManager:SetLibrary first!")
    return tab:AddLeftGroupbox("Themes")
end

function ThemeManager:ApplyToTab(tab)
    self:CreateThemeManager(self:CreateGroupBox(tab))
end

function ThemeManager:ApplyToGroupbox(groupbox)
    assert(self.Library, "Call ThemeManager:SetLibrary first!")
    self:CreateThemeManager(groupbox)
end

ThemeManager:BuildFolderTree()

return ThemeManager
