
local HttpService = game:GetService("HttpService")
local ThemeManager = {}

ThemeManager.Folder = "LinoriaLibSettings"
ThemeManager.Library = nil
ThemeManager.DefaultTheme = "Obsidian"

local function theme(font, main, accent, background, outline)
    return {
        FontColor = font,
        MainColor = main,
        AccentColor = accent,
        BackgroundColor = background,
        OutlineColor = outline,
    }
end

